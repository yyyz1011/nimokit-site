  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main product destination and collection CTA.",
      "html": "<a class=\"ds-primary\" href=\"#products\">Explore the collection<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-5-5 5 5-5 5\"/></svg></a>",
      "css": ".ds-primary{box-sizing:border-box;font-family:var(--font,Manrope,'PingFang SC','Microsoft YaHei',sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:50px;padding:13px 22px;border:0;border-radius:16px;font-size:14px;font-weight:700;line-height:1.5;text-decoration:none;background:#145bdd;color:#fff;transition:background .2s,transform .2s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-primary svg{width:22px;height:22px}.ds-primary:hover{background:#104bbd;transform:translateY(-2px)}.ds-primary:focus-visible{outline:3px solid var(--blue,#145bdd);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:hover{transform:none}}"
    },
    {
      "name": "Text link",
      "kind": "button",
      "refersTo": "link-text",
      "description": "Secondary navigation beside a primary action.",
      "html": "<a class=\"ds-text\" href=\"/about/\">A little about Nimokit<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-5-5 5 5-5 5\"/></svg></a>",
      "css": ".ds-text{font-family:var(--font,Manrope,'PingFang SC','Microsoft YaHei',sans-serif);display:inline-flex;align-items:center;gap:10px;min-height:44px;font-size:14px;font-weight:650;color:var(--blue,#145bdd);text-decoration:none;text-underline-offset:4px}.ds-text svg{width:22px;height:22px}.ds-text:hover{text-decoration:underline}.ds-text:focus-visible{outline:3px solid var(--blue,#145bdd);outline-offset:5px}"
    },
    {
      "name": "Icon control",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "44px icon target for appearance or header shortcuts.",
      "html": "<button class=\"ds-icon-control\" type=\"button\" aria-label=\"Switch to light mode\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5\"/></svg></button>",
      "css": ".ds-icon-control{font-family:var(--font,Manrope,'PingFang SC','Microsoft YaHei',sans-serif);display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;border:0;background:transparent;color:var(--ink,#182334);border-radius:14px;cursor:pointer}.ds-icon-control svg{width:22px;height:22px}.ds-icon-control:hover{background:var(--blue-wash,#e9f0ff)}.ds-icon-control:focus-visible{outline:3px solid var(--blue,#145bdd);outline-offset:5px}"
    },
    {
      "name": "Another thought",
      "kind": "button",
      "refersTo": "button-demo-answer",
      "description": "Bundled sample interaction; product service is not invoked.",
      "html": "<button class=\"ds-demo-answer\" type=\"button\">Turn a page<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-5-5 5 5-5 5\"/></svg></button>",
      "css": ".ds-demo-answer{font-family:var(--font,Manrope,'PingFang SC','Microsoft YaHei',sans-serif);display:flex;align-items:center;justify-content:center;gap:9px;min-height:44px;width:100%;font-size:12px;font-weight:650;border:0;border-radius:12px;background:var(--paper,#fff);color:var(--blue-deep,#1043a4);cursor:pointer}.ds-demo-answer svg{width:16px;height:16px}.ds-demo-answer:hover{background:var(--blue-wash,#e9f0ff)}.ds-demo-answer:focus-visible{outline:3px solid var(--blue,#145bdd);outline-offset:5px}"
